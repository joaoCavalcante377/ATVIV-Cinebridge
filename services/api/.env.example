# Execução fora do Docker (npm start / testes). No Compose da raiz, as variáveis vêm de docker.env.
DATABASE_URL=postgres://cinebridge:cinebridge@127.0.0.1:54329/cinebridge
TEST_DATABASE_URL=postgres://cinebridge:cinebridge@127.0.0.1:54329/cinebridge_test
HOST=127.0.0.1
PORT=3000
# ATVIII: provedores (simulados) e pilha de decoradores
ARMAZENAMENTO=local
ARMAZENAMENTO_DIR=.local/arquivos
PAGAMENTO=stripe
RECOMENDACAO_DECORADORES=cache,auditoria
# ATVIV: com AMQP_URL a API roda no modo distribuído (RabbitMQ e demais microsserviços).
# Sem ela, funciona no modo autônomo da ATVIII (cadastro e notificações locais).
# AMQP_URL=amqp://guest:guest@127.0.0.1:5672
# Aplica as migrações ao iniciar (usado no contêiner)
# DB_MIGRAR=true
# Testes de integração da mensageria (criam e removem um vhost temporário)
# TEST_AMQP_URL=amqp://guest:guest@127.0.0.1:5672
