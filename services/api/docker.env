# Configuração usada pelo docker-compose.yml (rede interna cinebridge-net).
# Credenciais de desenvolvimento local; troque-as antes de expor o ambiente.
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://cinebridge:cinebridge@recomendacoes-db:5432/recomendacoes
# Com AMQP_URL a API roda no modo distribuído (ATVIV)
AMQP_URL=amqp://guest:guest@cinebridge-mq:5672
# O banco do contêiner nasce vazio: aplica as migrações na inicialização
DB_MIGRAR=true
ARMAZENAMENTO=local
ARMAZENAMENTO_DIR=/usr/src/app/.local/arquivos
PAGAMENTO=stripe
RECOMENDACAO_DECORADORES=cache,auditoria
